# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploaded media (foto profil & tanda tangan) — persisted via docker volume
/public/uploads/*
!/public/uploads/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# mobile (flutter/flutterflow)
mobile/.dart_tool/
mobile/.build/
mobile/build/
mobile/android/.gradle/
mobile/ios/Pods/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# editor / IDE config
/.idea/
/.vscode/

# folder kerja sementara
/scratch/
/tmp/

# data internal Bank Nagari (warisan mtr-report, tidak dipakai kode EDPCtiket)
/master_atm_full.txt
/master_seed.json
/files 20.06.28/

