# Salin file ini jadi .env lalu isi nilai aslinya (jangan commit .env!):
#   cp .env.example .env

POSTGRES_USER=fq_user
POSTGRES_PASSWORD=ganti-password-database
POSTGRES_DB=fq_report_db

# Generate: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimum-32-karakter

# false kalau app diakses via HTTP polos (tanpa reverse proxy HTTPS di depan),
# true kalau sudah ada HTTPS (nginx/Cloudflare) di depan.
COOKIE_SECURE=false

# Opsional — token bot Telegram dari @BotFather.
TELEGRAM_BOT_TOKEN=
